# Server-side Gemini API Key (injected automatically by AI Studio or Cloud Run Secret Manager)
API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Client Configuration (Vite build-time environment variables)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:abcdef1234567890
VITE_FIREBASE_DATABASE_ID=(default)
VITE_FIREBASE_MEASUREMENT_ID=

# Server Configuration (Cloud Run injects PORT automatically)
PORT=3000
NODE_ENV=production
